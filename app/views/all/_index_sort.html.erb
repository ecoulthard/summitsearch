<!-- Creates a list of buttons for sorting records on index pages -->
<% place_id = nil unless defined? place_id %>
<span class="sort-label">Order by:</span>
<%= render layout: 'all/section_actions', locals: { label: "#{record_class.to_s.titleize.pluralize} sorting", menu_id: 'listing-actions' } do %>
  <% (record_class::SORT_OPTIONS.keys-[selected_sort]).sort.each do |sort| %>
    <%= link_to sort.titleize, send("#{record_class.to_s.tableize}_path", sort: sort, place_id: place_id), class: 'linkButton' %>
  <% end %>
<% end %>
