<li tabindex="2" class="not_search"><%= link_to "Index", main_app.listing_path, class: "drop" %>
    <div class="dropdown_4columns">
      <div class="col_1">
        <h3>&nbsp;</h3>
        <ul>
          <li><%= link_to "Home", main_app.root_path %></li>
          <li><%= link_to "Albums", main_app.albums_path %></li>
          <li><%= link_to "Fanatics Forum", thredded.root_path %></li>
          <li><%= link_to "Members", main_app.users_path %></li>
          <li><%= link_to "Mountains", main_app.mountains_path %></li>
          <li><%= link_to "People", main_app.people_path %></li>
          <li><%= link_to "Photos", main_app.photos_path %></li>
          <li><%= link_to "Trip Reports", main_app.trip_reports_path %></li>
        </ul>
      </div>
      <div class="col_1">
        <h3><%= link_to "Places", main_app.places_path %></h3>
        <ul>
          <% Place.subclass_types.take(10).each do |subclass| %>
            <li><%= link_to subclass.to_s.titleize.pluralize, send("#{subclass.to_s.tableize}_path") %></li>
          <% end %>
        </ul>
      </div>
      <div class="col_1">
        <h3>&nbsp;</h3>
        <ul>
          <% Place.subclass_types.drop(10).take(10).each do |subclass| %>
            <li><%= link_to subclass.to_s.titleize.pluralize, send("#{subclass.to_s.tableize}_path") %></li>
          <% end %>
        </ul>
      </div>

      <div class="col_1">
        <h3><%= link_to "Routes", main_app.routes_path %></h3>
        <ul>
          <% Route.subclass_types.each do |subclass| %>
            <li><%= link_to subclass.to_s.titleize.pluralize, send("#{subclass.to_s.tableize}_path") %></li>
          <% end %>
        </ul>
      </div>
    </div>  
  </li>
  <li tabindex="3" class="not_search"><%= link_to "Regions", main_app.regions_path, class: "drop" %>
    <div class="dropdown_4columns">
      <!-- Hardcoded the Coast, Columbia, Rockies and Cascade in here. -->
      <% Region.where(slug: ["canadian-rockies", "columbia-mountains", "coast-mountains", "cascade-mountains"]).each do |region| %>
        <div class="col_1">
          <h3><%= link_to truncate(region.name, length: 60), region %></h3>
          <ul>
            <% Place.subclass_types.each do |subclass| %>
              <% if region.places.where(type: subclass.to_s).count > 0 %>
                <li><%= link_to subclass.to_s.titleize.pluralize, send("#{subclass.to_s.tableize}_path", place_id: region.id) %></li>
              <% end %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </li>
  <li tabindex="4" class="not_search"><%= link_to "Forums", thredded.root_path, class: "drop" %>
    <div class="dropdown_4columns">
      <div class="col_1"><%= link_to "Active Topics", main_app.forum_active_topics_path %></div>
      <div class="col_1"><%= link_to "Unanswered Topics", main_app.forum_unanswered_topics_path %></div>
      <% forum_navigation_groups.each do |group, boards| %>
        <div class="col_2">
          <h3><%= group ? link_to(group.name, thredded.show_messageboard_group_path(group)) : "Forums" %></h3>
          <ul>
            <% boards.each do |board| %>
              <li class="no-wrap"><%= link_to board.name, thredded.messageboard_topics_path(board) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </li>
