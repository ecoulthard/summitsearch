<div id="place_list" class="resource-form" data-turbo="false">
  <h1 class="section-header">
    <span class="section-title">New <%= @type %><%= " and Trip Report" if @trip %></span>
    <span class="section-action-break"><br><br></span>
    <%= render layout: 'all/section_actions', locals: { label: 'Route form', menu_id: 'form-actions' } do %>
      <%= link_to 'Back to Routes', routes_path(type: @route&.type || params[:type]), class: 'linkButton' %>
    <% end %>
  </h1>

  <div class="form">
    <%= render 'form' %>
  </div>
</div>
