<div class="clear"></div><br>
<table class="subdued" cellspacing="0">
  <thead>
    <tr>
       <th colspan="4" class="section-header"><span class="section-title"><%= new ? "New" : "Recently Updated"  %> Mountains, Lakes, Waterfalls, Passes and Other Places</span>
         <% if new %>
           <%= render layout: 'all/section_actions', locals: { label: 'Places', menu_id: 'place-actions' } do %>
             <%= link_to "More New Places", places_path(sort: 'date_created'), class: 'linkButton' %>
           <% end %>
         <% end %>
       </th>
    </tr>
  </thead>
  <tbody>
    <% ss_cache({ part: 'places' }, expires_in: 1.week) do %>
      <% @place_groups.each do |places| %>
        <tr class="<%= cycle("odd", "even") %>">
          <% places.each do |place| %>
            <%= render partial: 'places/thumb', locals: { place: place } %>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<div class="clear"></div><br>

<table class="subdued" cellspacing="0">
  <thead>
    <tr>
       <th colspan="3" class="section-header"><span class="section-title"><%= new ? "New" : "Recently Updated" %> Routes</span>
         <% if new %>
           <%= render layout: 'all/section_actions', locals: { label: 'Routes', menu_id: 'route-actions' } do %>
             <%= link_to "More New Routes", routes_path(sort: 'date_created'), class: 'linkButton' %>
           <% end %>
         <% end %>
       </th>
    </tr>
  </thead>
  <tbody>
    <% ss_cache({ part: 'routes' }, expires_in: 12.hours) do %>
      <% @route_groups.each do |routes| %>
        <tr class="<%= cycle("odd", "even") %>">
          <% routes.each do |route| %>
            <%= render partial: 'routes/thumb', locals: { route: route } %>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<div class="clear"></div><br>
