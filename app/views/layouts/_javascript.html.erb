<% # Javascript that doesn't need to call document.write should go in this partial. This makes the page display before the javascript is downloaded. %>

<%= mytopo_data %>

<script type="text/javascript">
  <% if defined? @DoNotTrack %>
    var doNotTrack = <%= @DoNotTrack %>;
  <% else %>
    var doNotTrack = false;
  <% end %>
  var facebookAppId = <%= raw json_escape(facebookAppId.to_json) %>;
  var facebookChannelUrl = '//summitsearch.org/channel.html';
</script>
<div id="fb-root"></div>
<%= javascript_importmap_tags %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

<%= yield(:javascript) %>
