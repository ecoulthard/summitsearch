<!DOCTYPE html>
<html>
<%= render 'layouts/header', default_title: "Summit Search", app: "main" %>
<body id="main" class="nomenu <%= controller_name %> <%= action_name %>">
  <div id="short_banner" title="Click here to go to home">
    <%= link_to @page_title || "Summit Search", root_path %>
  </div>
  <div id="nomenu">
    <% if notice %>
      <p id="notice" class="notice"><%= raw notice %></p>
    <% end %>
    <% if alert %>
      <p id="alert" class="notice"><%= alert %></p>
    <% end %>
    <%= yield %>
  </div>

  <%= render 'layouts/javascript', app: "main" %>
</body>
</html>
