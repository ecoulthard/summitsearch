<div id="place_list" class="record-listing">

<% if @photos.empty? %>
  <p class="notice"><%= "There are no photos to list" %></p>
<% end %>

<h1 class="section-header">
  <span class="section-title">
  Listing Photos
  <% if defined?(@area) && @area.present? %>
    <%= "in #{@area.name}" %>
  <% end %>
  <% if !@lower.nil? && !@upper.nil? %>
    <%= "from (#{@lower} - #{@upper})" %>
  <% end %>
  </span>
  <span class="section-action-break"><br><br></span>
  <%= render partial: 'all/index_sort', locals: { record_class: Photo, selected_sort: @sort, area_id: (defined?(@area) && @area.present? ? @area.id : nil) } %>
  <span class="section-action-break"><br><br></span>
  <%= will_paginate @records, inner_window: 10, outer_window: 2 if defined?(will_paginate) && @records.respond_to?(:total_pages) %>
</h1>

<div class="clear"></div>
<div class="photo-list-grid">
<% @photos.each do |photo| %>
  <%= render partial: 'thumb', locals: { photo: photo } %>
<% end %>
</div>
<div class="clear"></div>

<h2>
  <%= will_paginate @records, inner_window: 10, outer_window: 2 if defined?(will_paginate) && @records.respond_to?(:total_pages) %>
</h2>

</div>
