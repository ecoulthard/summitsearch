<% text_only = false unless defined? text_only %>
<h2 class="section-header" data-turbo="false">
  <span class="section-title"><%= @has_photos ? "#{photo_type} Photos" : "No #{photo_type} Photos Yet" %></span>
  <% if @has_photos || place_tag != :user_id %>
    <%= render layout: 'all/section_actions', locals: { label: "#{photo_type} Photos", menu_id: "photos-#{place_tag}-#{place.to_param}-actions" } do %>
      <% if @has_photos %>
        <%= link_to 'View Slideshow', slideshow_photos_path(place_tag => place.id, type: 'Title'), rel: 'nofollow', data_popup: "true", class: 'linkButton' %>
        <%= link_to 'View Full Size Photos', show_full_photos_path(place_tag => place.id, type: 'Title'), rel: 'nofollow', data_popup: "true", class: 'linkButton' %>
      <% end %>
      <% if place_tag == :trip_report_id %>
        <%= link_to 'Insert/Edit Photos', multi_photos_trip_report_path(place_tag => place.id), rel: 'nofollow', class: 'linkButton', data: { turbo: false } %>
      <% elsif place_tag == :album_id %>
        <%= link_to 'Insert/Edit Photos', edit_album_path(place), rel: 'nofollow', class: 'linkButton', data: { turbo: false } %>
      <% elsif place_tag != :user_id %>
        <%= link_to 'Insert a Photo', new_photo_path(place_tag => place.id), rel: 'nofollow', class: 'linkButton', data: { turbo: false } %>
      <% end %>
    <% end %>
  <% end %>
</h2>
<% if @has_photos %>
  <% @photos.each do |photo| %>
    <%= render partial: 'photos/thumb', locals: { photo: photo, text_only: text_only } %>
  <% end %>
  <% unless place_tag == :trip_report_id %>
    <div><%= will_paginate @photos if defined?(will_paginate) && @photos.respond_to?(:total_pages) %></div>
  <% end %>
<% end %>
<% if @appears_in_other_photos %>
  <div class="clear"></div><br>
  <h2 class="section-header" data-turbo="false"><span class="section-title">Also mentioned in these photos</span>
    <%= render layout: 'all/section_actions', locals: { label: 'Photos Mentioning This Page', menu_id: "mentioned-photos-#{place_tag}-#{place.to_param}-actions" } do %>
      <%= link_to 'View Slideshow', slideshow_photos_path(place_tag => place.id, type: 'Mentioned'), rel: 'nofollow', data_popup: "true", class: 'linkButton' %>
      <%= link_to 'View Full Size Photos', show_full_photos_path(place_tag => place.id, type: 'Mentioned'), rel: 'nofollow', data_popup: "true", class: 'linkButton' %>
    <% end %>
  </h2>
  <% @photo_appearances.each do |photo| %>
    <%= render partial: 'photos/thumb', locals: { photo: photo, text_only: text_only } %>
  <% end %>
  <div><%= will_paginate @photo_appearances if defined?(will_paginate) && @photo_appearances.respond_to?(:total_pages) %></div>
<% end %>
