<div class="smallDiv" style="width:<%= photo.small_div_width %>px">
  <% if (!defined?(show_title) || show_title) && !photo.title.nil? %>
    <div style="width:<%= photo.small_div_width %>px"><%= link_to truncate(photo.title, length: 200), main_app.photo_path(photo), class: 'thumbTitle' %>&nbsp;</div>
  <% end %>
  <% if defined?(no_link) %>
    <%= photo_image_tag(photo, :small, alt: photo.alt, width: photo.small_width, height: photo.small_height) %><br>
  <% else %>
    <%= link_to photo_image_tag(photo, :small, alt: photo.alt, width: photo.small_width, height: photo.small_height), main_app.photo_path(photo), name: photo.id, data_popup: "true" %><br>
  <% end %>
  <div>By: <%= link_to truncate(photo.user&.display_name.to_s, length: 50), main_app.user_path(photo.user) if photo.user %></div>
  <div style="width:<%= photo.small_div_width %>px">
      <%= strip_tags(photo.caption.to_s) %>
  </div>
</div>
