<% if @forum.present? %>
  <div id="comments">
    <% if @topic && Thredded::TopicPolicy.new(@forum_user, @topic).read? %>
      <p><%= link_to "View discussion in the forum", thredded.messageboard_topic_path(@topic.messageboard, @topic), data: { turbo: false } %></p>
    <% end %>
    <h2><%= @posts.any? ? "Comments" : "No Comments Yet" %></h2>
    <%= will_paginate @posts if @posts.respond_to?(:total_pages) %>
    <div id="posts">
      <%= render partial: "articles/comment", collection: @posts, as: :post %>
    </div>
    <% if @can_comment %>
      <h2>Post a Comment</h2>
      <%= form_with url: comments_path, method: :post do |f| %>
        <%= f.label :text, "Comment (Markdown supported)" %>
        <%= f.text_area :text, value: @comment_text, rows: 10, cols: 80, required: true %>
        <%= render "forum_photos/picker", topic: @topic || @forum.topics.build(user: current_user), textarea_id: "text" %>
        <%= f.submit "Post Comment" %>
      <% end %>
    <% elsif !user_signed_in? %>
      <p><%= link_to "Sign in", new_user_session_path %> to post a comment.</p>
    <% else %>
      <p>Commenting is locked or unavailable.</p>
    <% end %>
  </div>
<% end %>
