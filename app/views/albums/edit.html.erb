<div id="place_list" class="resource-form" data-turbo="false">
  <h1 class="section-header">
    <span class="section-title">Edit <%= @album.title %></span>
    <span class="section-action-break"><br><br></span>
    <%= render layout: 'all/section_actions', locals: { label: 'Album form', menu_id: 'form-actions' } do %>
      <%= link_to 'View Album', @album, class: 'linkButton' %>
      <%= link_to 'Back to Albums', albums_path, class: 'linkButton' %>
    <% end %>
  </h1>

  <div class="form">
    <%= render 'form' %>
  </div>

  <%= render partial: 'all/multi_photo_upload', locals: { tag_name: 'album_id', class_name: 'Album' } %>
</div>
