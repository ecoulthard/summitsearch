<div id="place_list" class="resource-form" data-turbo="false">
  <h1 class="section-header">
    <span class="section-title">New <%= @type %></span>
    <span class="section-action-break"><br><br></span>
    <%= render layout: 'all/section_actions', locals: { label: 'Place form', menu_id: 'form-actions' } do %>
      <%= link_to 'Back to Places', places_path(type: @place.class.to_s), class: 'linkButton' %>
    <% end %>
  </h1>

  <div class="form">
    <%= render 'form' %>
  </div>
</div>
