<%= render partial: 'forem/posts/head', locals: { topic: @topic } %>

<%= form_with model: [forem, @topic.forum, @topic, @post] do |f| %>
  <%= f.submit t("forem.post.buttons.edit") %>
  <div class="clear"></div><br>
  <%= render partial: "form", locals: { f: f } %>
  <%= f.submit t("forem.post.buttons.edit") %>
<% end %>
